{
  "$defs": {
    "BearingSource": {
      "enum": [
        "head_motion",
        "mics",
        "camera",
        "fused"
      ],
      "title": "BearingSource",
      "type": "string"
    },
    "Source": {
      "description": "One separated, tracked sound source (also the public part of the target record).",
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "label": {
          "description": "\"speech\", \"music\", \"alarm\", ...",
          "title": "Label",
          "type": "string"
        },
        "label_conf": {
          "maximum": 1,
          "minimum": 0,
          "title": "Label Conf",
          "type": "number"
        },
        "bearing_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "World yaw, 0 = initial forward, + = right",
          "title": "Bearing Deg"
        },
        "bearing_conf": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Bearing Conf",
          "type": "number"
        },
        "bearing_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/BearingSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "elevation_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elevation Deg"
        },
        "distance_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distance M"
        },
        "state": {
          "$ref": "#/$defs/TrackState",
          "default": "tracking"
        },
        "level_db": {
          "description": "Current loudness of the separated source",
          "title": "Level Db",
          "type": "number"
        },
        "in_view": {
          "default": false,
          "title": "In View",
          "type": "boolean"
        },
        "bbox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Normalized x0,y0,x1,y1 in the latest camera frame",
          "title": "Bbox"
        },
        "mask_rle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mask Rle"
        },
        "last_observed_us": {
          "title": "Last Observed Us",
          "type": "integer"
        }
      },
      "required": [
        "source_id",
        "label",
        "label_conf",
        "level_db",
        "last_observed_us"
      ],
      "title": "Source",
      "type": "object"
    },
    "TrackState": {
      "enum": [
        "tracking",
        "last_seen",
        "lost"
      ],
      "title": "TrackState",
      "type": "string"
    }
  },
  "description": "Sent at ~10 Hz. Stable source_ids; clients must not re-announce on every update.",
  "properties": {
    "type": {
      "const": "sources.updated",
      "default": "sources.updated",
      "title": "Type",
      "type": "string"
    },
    "device_ts_us": {
      "title": "Device Ts Us",
      "type": "integer"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "device_ts_us",
    "sources"
  ],
  "title": "SourcesUpdated",
  "type": "object"
}
